---
/**
 * 404, in the same world and in both languages at once: the night scene as
 * a still poster, and one menu frame with the way back to each home page.
 */
import { footer, localeTag, locales, notFound } from '../content/site.ts';
import type { Snapshot } from '../data/schema.ts';
import snapshotJson from '../data/snapshot.json';
import { sceneSvg } from '../design/scene-svg.ts';
import Base from '../layouts/Base.astro';
import { buildView } from '../lib/view.ts';

const view = buildView(snapshotJson as unknown as Snapshot, 'en', { now: new Date(), sha: process.env.GIT_SHA ?? '' });
const home = { en: '/', pt: '/pt/' } as const;
const poster = sceneSvg({ width: 1600, height: 900, idPrefix: 'nf-' }).replace('<svg ', '<svg preserveAspectRatio="xMidYMax slice" ');
---

<Base
  view={view}
  title={`404 · ${notFound.title.en} · ${notFound.title.pt}`}
  description={`${notFound.text.en} ${notFound.text.pt}`}
  noindex
>
  <Fragment slot="skip">
    {
      locales.map((locale, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> / </span>}
          <span lang={localeTag[locale]}>{footer.skip[locale]}</span>
        </>
      ))
    }
  </Fragment>
  <div class="scene" aria-hidden="true" set:html={poster} />
  <main id="main" class="nf" tabindex="-1">
    <div class="frame card">
      <p class="display code" aria-hidden="true">404</p>
      {
        locales.map((locale, i) => (
          <section class="side" lang={localeTag[locale]} aria-labelledby={`nf-${locale}`}>
            {i === 0 ? (
              <h1 class="title" id={`nf-${locale}`}>
                {notFound.title[locale]}
              </h1>
            ) : (
              <h2 class="title" id={`nf-${locale}`}>
                {notFound.title[locale]}
              </h2>
            )}
            <p class="text">{notFound.text[locale]}</p>
            <a class="action action-primary" href={home[locale]}>
              {notFound.home[locale]}
            </a>
          </section>
        ))
      }
    </div>
  </main>
</Base>

<style>
  .scene {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: var(--c-night);
  }
  .scene :global(svg) {
    inline-size: 100%;
    block-size: 100%;
  }
  .scene::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 60% at 30% 50%, color-mix(in srgb, var(--c-night) 70%, transparent), transparent 80%);
  }
  .nf {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center start;
    min-block-size: 100dvh;
    padding: var(--s-8) var(--pad);
  }
  .card {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-8);
    max-inline-size: 46rem;
  }
  .code {
    grid-column: 1 / -1;
    color: var(--c-brand);
    font-size: clamp(4rem, 2rem + 8vw, 6rem);
    transform: skewX(-8deg);
  }
  .side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
  }
  .title {
    font-size: 1.5rem;
    font-weight: 750;
    line-height: 1.25;
  }
  .text {
    color: var(--c-ink2);
  }
  @media (max-width: 47.99rem) {
    .card {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
