---
/** The anchor every entry carries: #<id>, drawn hash glyph. */
import Icon from './Icon.astro';

interface Props {
  id: string;
  name: string;
  label: string;
}

const { id, name, label } = Astro.props;
---

<a class="permalink" href={`#${id}`} aria-label={`${label}: ${name}`}><Icon name="hash" /></a>

<style>
  .permalink {
    display: inline-grid;
    flex: none;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    color: var(--c-ink2);
    opacity: 0;
    text-decoration: none;
    transition: opacity var(--d-fast) var(--ease);
  }
  :global([data-entry]:is(:hover, :focus-within, :target)) .permalink,
  .permalink:focus-visible {
    opacity: 1;
  }
  @media (hover: none) {
    .permalink {
      opacity: 1;
    }
  }
</style>
