---
/**
 * The nav as a pause menu: a floating menu frame with the pink script
 * handle, the plain section nouns in pink, and the language switch. The
 * current or hovered item sits on the green selection bar; the scroll spy
 * sets aria-current on the section in view.
 *
 * Under 70rem (where the row no longer fits) the nouns fold behind a compact MENU button (pause bars) that
 * opens them as an overlay panel under the frame: aria-expanded, focus
 * kept inside, Esc and outside clicks close (src/scripts/menu.ts). Without
 * scripts the nouns stay one row that scrolls sideways, snapping per item.
 */
import type { SiteView } from '../lib/view.ts';
import Icon from './Icon.astro';

interface Props {
  view: SiteView;
}

const { view } = Astro.props;
---

<header class="site-header" data-menu>
  <div class="menu">
    <a class="handle" href={view.href}>{view.person.handle}</a>
    <button class="toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle data-js-only>
      <Icon name="pause" size={14} />
      <span>Menu</span>
    </button>
    <nav class="nav" id="site-nav" aria-label={view.ui.nav}>
      <ul>
        {
          view.nav.map((item) => (
            <li>
              <a href={item.href} data-spy={item.href.slice(1)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="lang" href={view.alternate.href} hreflang={view.alternate.lang} lang={view.alternate.lang}>
      {view.footer.switchTo}
    </a>
  </div>
</header>

<script>
  import '../scripts/scrollspy.ts';
  import '../scripts/menu.ts';
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    block-size: var(--header-h);
    margin-block-end: calc(var(--header-h) * -1);
    padding: var(--s-3) var(--pad) 0;
    pointer-events: none;
  }
  .menu {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-4);
    max-inline-size: calc(var(--max) - 2 * var(--pad));
    block-size: 3.25rem;
    margin-inline: auto;
    padding-inline: var(--s-4) var(--s-2);
    border: 3px solid var(--outline);
    border-radius: 14px;
    background: color-mix(in srgb, var(--c-panel) 94%, transparent);
    box-shadow: var(--shadow);
    pointer-events: auto;
  }
  .handle {
    flex: none;
    color: var(--c-brand);
    font-family: var(--script);
    font-size: 1.625rem;
    line-height: 1;
    padding: 0.1em 0.3em 0.15em 0.1em;
    text-decoration: none;
    text-shadow: 0 0 0.35em var(--glow-pink);
  }
  .nav {
    flex: 1;
    min-inline-size: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav ul {
    display: flex;
    gap: var(--s-1);
  }
  .nav a,
  .lang,
  .toggle {
    display: inline-flex;
    align-items: center;
    block-size: 2.25rem;
    padding: 0.2em var(--s-3) 0;
    border-radius: 8px;
    color: var(--c-brand);
    font-family: var(--display);
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav a:hover,
  .nav a[aria-current='true'],
  .lang:hover,
  .toggle:hover,
  .toggle[aria-expanded='true'] {
    background: var(--c-select);
    color: var(--c-on-select);
  }
  .nav a:focus-visible,
  .lang:focus-visible,
  .toggle:focus-visible {
    outline-offset: 2px;
    background: var(--c-select);
    color: var(--c-on-select);
  }
  .lang {
    flex: none;
    margin-inline-start: auto;
    color: var(--c-ink);
    font-family: var(--sans);
    font-size: var(--t-small);
    font-weight: 700;
    padding-block-start: 0;
  }

  /* The compact MENU button: pause bars and the word, a pause-menu key. */
  .toggle {
    display: none;
    flex: none;
    gap: var(--s-2);
    border: 0;
    background: none;
    text-transform: uppercase;
    cursor: pointer;
  }
  .toggle :global(.icon) {
    transform: translateY(-0.1em);
  }

  /* Keep in step with `compact` in src/scripts/menu.ts. */
  @media (max-width: 69.99rem) {
    /* No scripts: one row that scrolls sideways, per item, with a fade at the end. */
    .nav {
      mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--s-1);
    }
    .nav li {
      scroll-snap-align: start;
    }

    /* Scripts: the nouns fold into the pause-menu panel. */
    [data-menu][data-ready] .toggle {
      display: inline-flex;
    }
    [data-menu][data-ready] .nav {
      position: absolute;
      inset-block-start: calc(100% + var(--s-2));
      inset-inline: -3px;
      display: none;
      padding: var(--s-3);
      border: 3px solid var(--outline);
      border-radius: 14px;
      background: var(--c-panel);
      box-shadow:
        inset 0 0 0 1px var(--c-rule),
        var(--shadow);
      mask-image: none;
      overflow: visible;
    }
    [data-menu][data-open] .nav {
      display: block;
    }
    [data-menu][data-ready] .nav ul {
      flex-direction: column;
      gap: var(--s-1);
    }
    [data-menu][data-ready] .nav a {
      inline-size: 100%;
      block-size: 3rem;
      padding-inline: var(--s-4);
      font-size: 1.25rem;
    }
    /* The rest of the page dims while the menu is open; a tap on it closes. */
    [data-menu][data-open]::before {
      content: '';
      position: fixed;
      inset: 0;
      background: color-mix(in srgb, var(--c-night) 72%, transparent);
      pointer-events: auto;
    }
  }
  @media (max-width: 47.99rem) {
    .handle {
      display: none;
    }
    .menu {
      padding-inline-start: var(--s-2);
    }
  }
</style>
