---
/**
 * The nav as a pause menu: a floating menu frame with the pink script
 * handle, the plain section nouns in pink, and the language switch. The
 * current or hovered item sits on the green selection bar; the scroll spy
 * sets aria-current on the section in view.
 */
import type { SiteView } from '../lib/view.ts';

interface Props {
  view: SiteView;
}

const { view } = Astro.props;
---

<header class="site-header">
  <div class="menu">
    <a class="handle" href={view.href}>{view.person.handle}</a>
    <nav class="nav" aria-label={view.ui.nav}>
      <ul>
        {
          view.nav.map((item) => (
            <li>
              <a href={item.href} data-spy={item.href.slice(1)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="lang" href={view.alternate.href} hreflang={view.alternate.lang} lang={view.alternate.lang}>
      {view.footer.switchTo}
    </a>
  </div>
</header>

<script>
  import '../scripts/scrollspy.ts';
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    block-size: var(--header-h);
    margin-block-end: calc(var(--header-h) * -1);
    padding: var(--s-3) var(--pad) 0;
    pointer-events: none;
  }
  .menu {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    max-inline-size: calc(var(--max) - 2 * var(--pad));
    block-size: 3.25rem;
    margin-inline: auto;
    padding-inline: var(--s-4) var(--s-2);
    border: 3px solid var(--outline);
    border-radius: 14px;
    background: color-mix(in srgb, var(--c-panel) 94%, transparent);
    box-shadow: var(--shadow);
    pointer-events: auto;
  }
  .handle {
    flex: none;
    color: var(--c-brand);
    font-family: var(--script);
    font-size: 1.625rem;
    line-height: 1;
    padding: 0.1em 0.3em 0.15em 0.1em;
    text-decoration: none;
    text-shadow: 0 0 0.35em var(--glow-pink);
  }
  .nav {
    flex: 1;
    min-inline-size: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav ul {
    display: flex;
    gap: var(--s-1);
  }
  .nav a,
  .lang {
    display: inline-flex;
    align-items: center;
    block-size: 2.25rem;
    padding: 0.2em var(--s-3) 0;
    border-radius: 8px;
    color: var(--c-brand);
    font-family: var(--display);
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav a:hover,
  .nav a[aria-current='true'],
  .lang:hover {
    background: var(--c-select);
    color: var(--c-on-select);
  }
  .nav a:focus-visible,
  .lang:focus-visible {
    outline-offset: 2px;
    background: var(--c-select);
    color: var(--c-on-select);
  }
  .lang {
    flex: none;
    margin-inline-start: auto;
    color: var(--c-ink);
    font-family: var(--sans);
    font-size: var(--t-small);
    font-weight: 700;
    padding-block-start: 0;
  }
  @media (max-width: 63.99rem) {
    .nav {
      mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
    }
  }
  @media (max-width: 47.99rem) {
    .handle {
      display: none;
    }
    .menu {
      padding-inline-start: var(--s-2);
    }
  }
</style>
