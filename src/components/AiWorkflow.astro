---
/**
 * How I work with AI, the centerpiece after the hero: the method as a
 * numbered sequence inside a menu frame (the order is real: a change goes
 * through spec, team, review, proof, research, memory, guardrails and the
 * on-call agent), each step with its tools as chips, then the proof line
 * (this site was built this way) and a one-line row of the agent tooling
 * he publishes. The projects stay brief on purpose.
 */
import type { SiteView } from '../lib/view.ts';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  view: SiteView;
}

const { view } = Astro.props;
const s = view.sections.ai;
const m = view.aiWorkflow;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="band ai" id="ai" aria-labelledby="ai-title">
  <div class="wrap">
    <SectionHead id="ai" label={s.label} claim={s.claim} />

    <div class="frame method-frame">
      <h3 class="frame-label method-label">{m.label}</h3>
      <ol class="method">
        {
          m.items.map((item, i) => (
            <li class="step">
              <span class="hud-n num" aria-hidden="true">
                {pad(i)}
              </span>
              <div class="step-body">
                <h4 class="step-name">{item.name}</h4>
                <p class="step-text">{item.text}</p>
                <ul class="chips">
                  {item.tools.map((tool) => (
                    <li>{tool}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="built">
        <a href={m.builtWithHref}>
          {m.builtWith}
          <Icon name="external" size={12} />
        </a>
      </p>
    </div>

    <div class="projects">
      <h3 class="projects-label">{m.projectsLabel}</h3>
      <ul class="projects-list">
        {
          view.ai.map((item) => {
            const href = item.links[0]?.href;
            const proof = item.proofs[0];
            return (
              <li id={item.id}>
                {href ? <a href={href}>{item.name}</a> : <span>{item.name}</span>}
                {proof && (
                  <span class="proof">
                    <span class="hud-n">{proof.value}</span> {proof.label}
                  </span>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .method-frame {
    padding-block-start: var(--s-8);
  }
  .method-label {
    position: absolute;
    inset-block-start: var(--s-5);
    inset-inline-end: var(--s-6);
  }
  .method {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-7) var(--s-8);
  }
  .step {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    column-gap: var(--s-4);
    align-items: start;
  }
  .num {
    color: var(--c-added);
    font-size: 2.25rem;
    line-height: 1;
    text-shadow: 0 0 0.35em var(--glow-cyan);
  }
  .step-body {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .step-name {
    color: var(--c-ink);
    font-size: 1.1875rem;
    font-weight: 750;
    line-height: 1.3;
  }
  .step-text {
    max-inline-size: 60ch;
    color: var(--c-ink2);
    font-size: 1rem;
    line-height: 1.6;
  }
  .step .chips {
    margin-block-start: var(--s-1);
  }
  .built {
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-5);
    border-block-start: 1px solid var(--c-rule);
    font-weight: 600;
  }
  .built a {
    display: inline;
  }
  .built :global(.icon) {
    display: inline;
    margin-inline-start: var(--s-1);
    vertical-align: middle;
  }

  .projects {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-3) var(--s-5);
    margin-block-start: var(--s-8);
  }
  .projects-label {
    color: var(--c-brand);
    font-family: var(--hud);
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .projects-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    font-size: var(--t-small);
  }
  .projects-list a {
    font-weight: 700;
  }
  .proof {
    margin-inline-start: var(--s-2);
    color: var(--c-ink3);
  }
  .proof .hud-n {
    color: var(--c-merged-text);
    -webkit-text-stroke: 0;
    font-size: 0.8125rem;
  }

  @media (max-width: 63.99rem) {
    .method {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 29.99rem) {
    .step {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s-2);
    }
    .method-label {
      position: static;
      margin-block-end: var(--s-5);
    }
    .method-frame {
      padding-block-start: var(--s-6);
    }
  }
</style>
