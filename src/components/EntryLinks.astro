---
/**
 * Where to check an entry. Private products say so instead of showing a
 * repository link; a live site, when there is one, still links.
 */
import type { LinkView } from '../lib/view.ts';
import Icon from './Icon.astro';

interface Props {
  links: LinkView[];
  isPrivate: boolean;
  privateLabel: string;
}

const { links, isPrivate, privateLabel } = Astro.props;
---

{
  (links.length > 0 || isPrivate) && (
    <ul class="links">
      {links.map((link) => (
        <li>
          <a href={link.href}>
            {link.label}
            <Icon name="external" size={12} />
          </a>
        </li>
      ))}
      {isPrivate && (
        <li class="private">
          <Icon name="lock" size={14} />
          {privateLabel}
        </li>
      )}
    </ul>
  )
}

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-5);
    font-size: var(--t-small);
    font-weight: 600;
    line-height: 1.25rem;
  }
  a,
  .private {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
  }
  a {
    min-block-size: var(--s-5);
  }
  .private {
    color: var(--fg-2);
    font-weight: 500;
  }
</style>
