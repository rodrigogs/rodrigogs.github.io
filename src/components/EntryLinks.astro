---
/**
 * Where to check an entry: its repository, live site, package or docs.
 */
import type { LinkView } from '../lib/view.ts';
import Icon from './Icon.astro';

interface Props {
  links: LinkView[];
}

const { links } = Astro.props;
---

{
  links.length > 0 && (
    <ul class="links">
      {links.map((link) => (
        <li>
          <a href={link.href}>
            {link.label}
            <Icon name="external" size={12} />
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-5);
    font-size: var(--t-small);
    font-weight: 700;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    min-block-size: 2rem;
    padding-inline: 0.25rem;
  }
</style>
