---
/**
 * Stack: what he ships with (large chips), the grouped tooling, then the
 * radio tuner that diffs the stack between any two years.
 */
import type { SiteView } from '../lib/view.ts';
import Compare from './Compare.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  view: SiteView;
}

const { view } = Astro.props;
const s = view.sections.stack;
const t = view.stack;
---

<section class="band stack" id="stack" aria-labelledby="stack-title">
  <div class="wrap">
    <SectionHead id="stack" label={s.label} claim={s.claim} />
    <div class="layout">
      <div class="manifest">
        <div class="ships">
          <h3 class="group-label">{t.ships.label}</h3>
          <ul class="chips ships-list">
            {t.ships.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <dl class="groups">
          {
            t.groups.map((g) => (
              <div class="group">
                <dt class="group-label">{g.label}</dt>
                <dd>
                  <ul class="chips">
                    {g.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
      <Compare view={view} />
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-8);
    align-items: start;
  }
  .manifest {
    display: flex;
    flex-direction: column;
    gap: var(--s-7);
  }
  .group-label {
    margin-block-end: var(--s-3);
    color: var(--c-brand);
    font-family: var(--hud);
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .ships-list li {
    min-block-size: 2.25rem;
    padding-inline: var(--s-4);
    border: 2px solid var(--c-brand);
    background: color-mix(in srgb, var(--c-brand) 12%, var(--c-night));
    color: var(--c-ink);
    font-size: 1rem;
    font-weight: 700;
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-6);
  }
  @media (max-width: 63.99rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 47.99rem) {
    .groups {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
