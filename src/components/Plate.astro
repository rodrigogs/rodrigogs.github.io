---
/**
 * Role tag plate: a solid role fill with on-role text, set in the HUD face.
 * Used for hero note labels, entry status and the current career role.
 */
import type { Role } from '../design/tokens.ts';

interface Props {
  role: Role;
  class?: string;
}

const { role, class: cls } = Astro.props;
---

<span class:list={['plate', cls]} data-role={role}><slot /></span>
