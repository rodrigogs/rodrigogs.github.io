---
/**
 * "Copy address": copies the email and confirms in place ("Copied"),
 * announced politely. Hidden without JS (it could not work), so the mailto
 * action beside it always carries the job on its own.
 */
import Icon from './Icon.astro';

interface Props {
  email: string;
  copy: string;
  copied: string;
  showAddress?: boolean;
  class?: string;
}

const { email, copy, copied, showAddress = true, class: cls } = Astro.props;
---

<button type="button" class:list={['action', 'copy', cls]} data-copy={email} data-copied={copied} data-js-only>
  {showAddress && <span class="addr mono">{email}</span>}
  <span class="state" aria-hidden="true">
    <Icon name="copy" class="i-copy" />
    <Icon name="check" class="i-check" />
  </span>
  <span class="label">
    <span class="idle">{copy}</span>
    <span class="done" aria-hidden="true">{copied}</span>
  </span>
</button>
<span class="sr-only" role="status" aria-live="polite" data-copy-status></span>

<style>
  .copy {
    gap: var(--s-3);
    padding-inline: var(--s-3);
    white-space: nowrap;
  }
  /* Narrow screens: the address would squeeze the label onto two lines. */
  @media (max-width: 29.99rem) {
    .addr {
      display: none;
    }
  }
  .addr {
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: -0.02em;
    padding-inline-end: var(--s-2);
    border-inline-end: 1px solid var(--line);
    line-height: var(--s-6);
  }
  .state {
    position: relative;
    inline-size: 16px;
    block-size: 16px;
  }
  .state :global(.icon) {
    position: absolute;
    inset: 0;
    transition:
      opacity var(--d-fast) var(--ease),
      transform var(--d-base) var(--ease);
  }
  .state :global(.i-check) {
    opacity: 0;
    transform: scale(0.6);
  }
  .copy[data-state='copied'] .state :global(.i-copy) {
    opacity: 0;
    transform: scale(0.6);
  }
  .copy[data-state='copied'] .state :global(.i-check) {
    opacity: 1;
    transform: none;
  }
  /* Both labels share one cell, so the button keeps its width. */
  .label {
    display: inline-grid;
    font-size: var(--t-small);
  }
  .idle,
  .done {
    grid-area: 1 / 1;
    transition: opacity var(--d-fast) var(--ease);
  }
  .done,
  .copy[data-state='copied'] .idle {
    opacity: 0;
  }
  .copy[data-state='copied'] .done {
    opacity: 1;
  }
</style>

<script>
  import '../scripts/copy.ts';
</script>
