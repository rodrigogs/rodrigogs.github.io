---
/**
 * "Copy address": copies the email, flips its icon and label to "Copied"
 * and stamps the toast (Toast.astro announces it). Hidden without JS (it
 * could not work), so the mailto action beside it carries the job alone.
 */
import Icon from './Icon.astro';

interface Props {
  email: string;
  copy: string;
  copied: string;
  class?: string;
}

const { email, copy, copied, class: cls } = Astro.props;
---

<button type="button" class:list={['action', 'copy', cls]} data-copy={email} data-js-only>
  <span class="state" aria-hidden="true">
    <Icon name="copy" class="i-copy" />
    <Icon name="check" class="i-check" />
  </span>
  <span class="label">
    <span class="idle">{copy}</span>
    <span class="done" aria-hidden="true">{copied}</span>
  </span>
</button>

<style>
  .state {
    position: relative;
    inline-size: 16px;
    block-size: 16px;
  }
  .state :global(.icon) {
    position: absolute;
    inset: 0;
    transition:
      opacity var(--d-fast) var(--ease),
      transform var(--d-base) var(--ease);
  }
  .state :global(.i-check) {
    opacity: 0;
    transform: scale(0.6);
  }
  .copy[data-state='copied'] .state :global(.i-copy) {
    opacity: 0;
    transform: scale(0.6);
  }
  .copy[data-state='copied'] .state :global(.i-check) {
    opacity: 1;
    transform: none;
  }
  /* Both labels share one cell, so the button keeps its width. */
  .label {
    display: inline-grid;
  }
  .idle,
  .done {
    grid-area: 1 / 1;
    transition: opacity var(--d-fast) var(--ease);
  }
  .done,
  .copy[data-state='copied'] .idle {
    opacity: 0;
  }
  .copy[data-state='copied'] .done {
    opacity: 1;
  }
</style>

<script>
  import '../scripts/copy.ts';
</script>
