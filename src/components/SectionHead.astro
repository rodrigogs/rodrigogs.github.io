---
/**
 * Every section opens the same way: its plain noun as the heading, in the
 * outlined display face, then its one claim sentence.
 */
interface Props {
  id: string;
  label: string;
  claim: string;
  class?: string;
}

const { id, label, claim, class: cls } = Astro.props;
---

<header class:list={['section-head', cls]}>
  <h2 class="display section-title" id={`${id}-title`}>{label}</h2>
  <p class="claim">{claim}</p>
  <slot />
</header>
