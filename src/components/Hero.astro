---
/**
 * The first viewport: a night drive over the water. Layers, back to front:
 *   L0 the static SVG scene (first paint, and the fallback everywhere),
 *   L1 the live WebGL canvas, faded in after its first frame,
 *   the cheat-code floor grid (only while the canvas is not running),
 *   L2 the skyline with neon edges, the causeway and the shore, crisp SVG,
 *   L3 what moves over it, each its own small layer animated by CSS
 *      transforms only: a plane crossing the sky, a car with light trails
 *      on the causeway, and the palms swaying from their feet,
 *   L4 the text, on a scrim, left of the sun.
 * Top right: the HUD (live local time and real numbers, each linking to
 * its proof). The sun is placed by the same rule in CSS and in the shader
 * (see --sun-at), so it never sits under the text.
 */
import { SUN_X, sceneActors, sceneGeometry, sceneGridSvg, sceneSilhouettesSvg, sceneSvg } from '../design/scene-svg.ts';
import type { SiteView } from '../lib/view.ts';
import CopyEmail from './CopyEmail.astro';
import Icon, { type IconName } from './Icon.astro';
import Plate from './Plate.astro';

interface Props {
  view: SiteView;
}

const { view } = Astro.props;
const { hero, person, totals, field, ui } = view;
const [first, ...rest] = person.name.split(' ');
const size = { width: 1600, height: 900 };
const poster = sceneSvg({ ...size, idPrefix: 'hp-', palms: false, skyline: false });
const floor = sceneGridSvg({ ...size, idPrefix: 'hg-' });
const silhouettes = sceneSilhouettesSvg({ ...size, idPrefix: 'hs-', trees: false, causeway: true });
const actors = sceneActors({ ...size, idPrefix: 'ha-' });
/** Palm sway: period, phase and amplitude per tree, so no two move together. */
const sway = [
  { dur: 7.4, delay: -1.2, amp: 1.4 },
  { dur: 6.3, delay: -4.1, amp: 1.7 },
  { dur: 8.6, delay: -2.6, amp: 1.3 },
  { dur: 7.9, delay: -5.8, amp: 1.5 },
];
/** Scene units as custom properties on a stage child (1 unit = 1/1600 of the stage width). */
const box = (a: { x: number; y: number; width: number; height: number }) =>
  `--x: ${a.x}; --y: ${a.y}; --bw: ${a.width}; --bh: ${a.height}`;
/** The sun radius as a fraction of the scene width, so the CSS can find the disk's left edge. */
const sunR = sceneGeometry(size.width, size.height).sun.r / size.width;

interface Stat {
  icon: IconName;
  value: string;
  label: string;
  href: string;
  tone: 'pink' | 'yellow' | 'cyan';
}
const stats: Stat[] = [
  { icon: 'star', value: totals.stars, label: field.stars, href: `${person.github}?tab=repositories&sort=stargazers`, tone: 'pink' },
  { icon: 'download', value: totals.monthlyDownloads, label: field.downloadsMonth, href: `https://www.npmjs.com/~${person.handle}`, tone: 'yellow' },
  ...(totals.contributions
    ? [{ icon: 'pulse', value: totals.contributions, label: ui.contributions, href: person.github, tone: 'cyan' } satisfies Stat]
    : []),
] as const;
---

<section class="hero" id="hero" aria-labelledby="hero-name" data-hero>
  <div class="scene" aria-hidden="true" style={`--sun-x: ${SUN_X}; --sun-r: ${sunR}`}>
    <div class="layer" set:html={poster} />
    <canvas class="live" data-scene></canvas>
    <div class="layer floor" set:html={floor} />
    <div class="layer skyline" set:html={silhouettes} />
    <div class="layer skyline actors">
      <div class="stage">
        <div class="track fly" style={box(actors.plane)}>
          <div class="plane" style={box(actors.plane)}>
            <Fragment set:html={actors.plane.svg} />
            {actors.plane.beacons.map((b) => <span class="beacon" data-kind={b.kind} style={`--bx: ${b.x}; --by: ${b.y}`} />)}
          </div>
        </div>
        <div class="track drive" style={box(actors.car)}>
          <div class="car" style={box(actors.car)} set:html={actors.car.svg} />
        </div>
        {
          actors.palms.map((palm, i) => (
            <div
              class="palm"
              style={`${box(palm)}; --ox: ${palm.originX}; --oy: ${palm.originY}; --dur: ${sway[i % sway.length]!.dur}s; --delay: ${sway[i % sway.length]!.delay}s; --amp: ${sway[i % sway.length]!.amp}deg`}
              set:html={palm.svg}
            />
          ))
        }
      </div>
    </div>
    <div class="scrim"></div>
  </div>

  <div class="hud" role="group" aria-label={ui.hud}>
    <p class="clock" data-clock-wrap data-js-only>
      <span class="sr-only">{ui.time}</span>
      <time class="hud-n clock-n" data-clock></time>
      <span class="tz" aria-hidden="true">{person.timezone}</span>
    </p>
    <ul class="stats">
      {
        stats.map((s) => (
          <li>
            <a href={s.href} data-tone={s.tone}>
              <Icon name={s.icon} size={18} />
              <span class="hud-n stat-n">{s.value}</span>
              <span class="stat-l">{s.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="wrap copy">
    <h1 class="lockup" id="hero-name">
      <span class="script">{first}</span>
      <span class="display block">{rest.join(' ')}</span>
    </h1>

    <p class="role">{hero.title}</p>

    <ul class="notes">
      {
        hero.notes.map((note) => (
          <li>
            <Plate role={note.role}>{note.label}</Plate>
            <span class="note-text">{note.text}</span>
          </li>
        ))
      }
    </ul>

    <div class="actions">
      <a class="action action-primary" href={`mailto:${person.email}`}>
        <Icon name="mail" size={18} />
        {hero.cta.email}
      </a>
      <CopyEmail email={person.email} copy={hero.cta.copy} copied={hero.cta.copied} />
      <a class="action action-ghost" href={person.github}>
        GitHub
        <Icon name="external" size={12} />
      </a>
      {
        person.linkedin && (
          <a class="action action-ghost" href={person.linkedin}>
            LinkedIn
            <Icon name="external" size={12} />
          </a>
        )
      }
    </div>
  </div>
</section>

<script>
  // HUD clock: Rodrigo's local time, client-side only (a build-time time would lie).
  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  const wrap = clock?.closest<HTMLElement>('[data-clock-wrap]');
  if (clock && wrap) {
    const fmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'America/Sao_Paulo',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23',
    });
    const tick = () => {
      const now = new Date();
      clock.textContent = fmt.format(now);
      wrap.dataset.ready = '';
      setTimeout(tick, 60_000 - (now.getTime() % 60_000) + 50);
    };
    tick();
  }

  // The live scene loads after the page, on idle, and only where it can run well.
  const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-scene]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  // The CSS actors (plane, car, palms) pause while the hero is off screen.
  if (hero) new IntersectionObserver(([e]) => hero.toggleAttribute('data-away', !e?.isIntersecting)).observe(hero);
  const nav = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
  const weak =
    nav.connection?.saveData === true ||
    (nav.deviceMemory ?? 8) < 4 ||
    (matchMedia('(pointer: coarse)').matches && (nav.hardwareConcurrency ?? 8) <= 4);
  if (canvas && hero && !weak) {
    const go = () => import('../scripts/scene.ts').then((m) => m.start(canvas, hero));
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(go, { timeout: 1500 }) : setTimeout(go, 200));
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-block-size: max(100svh, 44rem);
    padding-block: calc(var(--header-h) + var(--s-8)) var(--s-9);
    overflow: hidden;
    isolation: isolate;
  }

  /* Scene ------------------------------------------------------------- */
  .scene {
    --sun-at: 0.7;
    position: absolute;
    inset: 0;
    z-index: -1;
    container-type: size;
    background: var(--scene-water-near);
  }
  /* Cover, bottom-aligned, the sun at --sun-at of the width (clamped so the
     scene always covers). scene.ts computes the same placement. From it:
     the sun disk's left edge, and the right edge of the text column. */
  .layer,
  .live,
  .scrim {
    --w: max(100cqw, 177.78cqh);
    --x0: clamp(calc(100cqw - var(--w)), calc(var(--sun-at) * 100cqw - var(--sun-x) * var(--w)), 0px);
    --sun-left: calc(var(--x0) + (var(--sun-x) - var(--sun-r)) * var(--w));
    --col-end: calc(max(0px, (100cqw - var(--max)) / 2) + var(--pad) + min(40rem, 50cqw));
    position: absolute;
    inset: 0;
  }
  .layer :global(svg) {
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: var(--x0);
    inline-size: var(--w);
    block-size: calc(var(--w) * 0.5625);
  }
  .live {
    inline-size: 100%;
    block-size: 100%;
    opacity: 0;
    transition: opacity 900ms var(--ease);
  }
  .live:global(.on) {
    opacity: 1;
  }
  .floor {
    opacity: 0;
    transition: opacity var(--d-slow) var(--ease);
  }
  :global(:root[data-cheat]) .floor {
    opacity: 1;
  }
  .live:global(.on) ~ .floor {
    visibility: hidden;
  }
  /* The text column reads on a calm ground: the scrim holds to the
     column's right edge and clears by the sun's left edge; the skyline
     behind the column fades so its neon edges stay out of the text. */
  .scrim {
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--c-night) 92%, transparent) 0,
        color-mix(in srgb, var(--c-night) 84%, transparent) calc(var(--col-end) - 14rem),
        color-mix(in srgb, var(--c-night) 64%, transparent) var(--col-end),
        transparent max(var(--sun-left), calc(var(--col-end) + 1.5rem))
      ),
      linear-gradient(to top, var(--c-night) 0, transparent 16%);
  }
  @media (min-width: 64rem) {
    .skyline {
      mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.4) var(--col-end), #000 var(--sun-left));
    }
  }

  /* Actors: the same box as the scene SVGs, in scene units (1600 across).
     Everything here moves by transform only, on its own small layer. */
  .stage {
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: var(--x0);
    inline-size: var(--w);
    block-size: calc(var(--w) * 0.5625);
    container-type: size;
  }
  .stage > *,
  .track > * {
    --u: calc(100cqw / 1600);
    position: absolute;
  }
  .plane,
  .car,
  .palm {
    inset-inline-start: calc(var(--x) * var(--u));
    inline-size: calc(var(--bw) * var(--u));
    block-size: calc(var(--bh) * var(--u));
  }
  .palm {
    inset-block-start: calc(var(--y) * var(--u));
    transform-origin: calc(var(--ox) * 100%) calc(var(--oy) * 100%);
    animation: sway var(--dur) ease-in-out var(--delay) infinite alternate;
  }
  .stage :global(svg) {
    inline-size: 100%;
    block-size: 100%;
  }
  /* A track spans the stage at its actor's height; the actor starts just off one edge. */
  .track {
    inset-inline: 0;
    inset-block-start: calc(var(--y) * var(--u));
    block-size: calc(var(--bh) * var(--u));
    will-change: transform;
  }
  .track > * {
    inset-block-start: 0;
  }
  .drive {
    animation: drive 17s linear -3s infinite;
  }
  .drive .car {
    inset-inline-start: calc(var(--bw) * var(--u) * -1);
  }
  .fly {
    animation: fly 31s linear -4s infinite;
  }
  .fly .plane {
    inset-inline-start: 100%;
  }
  .beacon {
    position: absolute;
    inset-inline-start: calc(var(--bx) * 100%);
    inset-block-start: calc(var(--by) * 100%);
    inline-size: calc(var(--u) * 3.2);
    block-size: calc(var(--u) * 3.2);
    margin: calc(var(--u) * -1.6);
    border-radius: 50%;
    background: var(--scene-sun-bottom);
    box-shadow: 0 0 calc(var(--u) * 6) calc(var(--u) * 1.5) var(--scene-sun-bottom);
    animation: blink 1.5s steps(1) infinite;
  }
  .beacon[data-kind='white'] {
    background: var(--c-ink);
    box-shadow: 0 0 calc(var(--u) * 6) calc(var(--u) * 1.5) var(--c-ink);
    animation-duration: 1.1s;
    animation-delay: -0.4s;
  }
  @keyframes sway {
    from {
      transform: rotate(calc(var(--amp) * -1));
    }
    to {
      transform: rotate(var(--amp));
    }
  }
  /* 13.6 s across, then a short empty road before the next pass. */
  @keyframes drive {
    from {
      transform: translateX(0);
    }
    80%,
    to {
      transform: translateX(calc(100cqw + var(--bw) * var(--u)));
    }
  }
  @keyframes fly {
    from {
      transform: translateX(0);
    }
    85%,
    to {
      transform: translateX(calc(-100cqw - var(--bw) * var(--u)));
    }
  }
  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    40% {
      opacity: 0.15;
    }
  }
  .hero[data-away] .actors * {
    animation-play-state: paused;
  }
  /* Reduced motion: nothing drives, flies or sways; the car and the plane stay off stage. */
  @media (prefers-reduced-motion: reduce) {
    .palm,
    .track,
    .beacon {
      animation: none;
    }
  }

  /* HUD --------------------------------------------------------------- */
  .hud {
    position: absolute;
    inset-block-start: calc(var(--header-h) + var(--s-5));
    inset-inline-end: var(--pad);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--s-2);
    text-align: end;
  }
  .clock {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    min-block-size: 3rem;
    visibility: hidden;
  }
  .clock[data-ready] {
    visibility: visible;
  }
  .clock-n {
    color: var(--c-added);
    font-size: 2.5rem;
    line-height: 1;
    text-shadow: 0 0 0.4em var(--glow-cyan);
  }
  .tz {
    color: var(--c-ink2);
    font-family: var(--hud);
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.08em;
    paint-order: stroke fill;
    -webkit-text-stroke: 0.3em var(--outline);
  }
  .stats {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--s-1);
  }
  .stats a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.125rem var(--s-2);
    text-decoration: none;
    border-radius: 6px;
    color: var(--tone);
  }
  .stats a:hover {
    background: var(--c-select);
    color: var(--c-on-select);
  }
  .stats a:hover .stat-n,
  .stats a:hover .stat-l {
    color: var(--c-on-select);
    -webkit-text-stroke: 0;
  }
  .stats a[data-tone='pink'] {
    --tone: var(--c-brand);
  }
  .stats a[data-tone='yellow'] {
    --tone: var(--c-changed);
  }
  .stats a[data-tone='cyan'] {
    --tone: var(--c-added);
  }
  .stats :global(.icon) {
    filter: drop-shadow(0 1px 0 var(--outline)) drop-shadow(0 -1px 0 var(--outline)) drop-shadow(1px 0 0 var(--outline))
      drop-shadow(-1px 0 0 var(--outline));
  }
  .stat-n {
    color: var(--tone);
    font-size: 1.375rem;
    line-height: 1.2;
  }
  .stat-l {
    color: var(--c-ink);
    font-size: var(--t-micro);
    font-weight: 600;
    paint-order: stroke fill;
    -webkit-text-stroke: 0.35em var(--outline);
    order: -1;
  }

  /* Text -------------------------------------------------------------- */
  .copy {
    position: relative;
  }
  .notes {
    max-inline-size: min(40rem, 50vw);
  }
  .lockup {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-weight: 400;
    cursor: default;
  }
  .script {
    position: relative;
    z-index: 1;
    margin-inline-start: 0.08em;
    margin-block-end: -0.24em;
    color: var(--c-brand);
    font-family: var(--script);
    font-size: clamp(3.5rem, 1.6rem + 5.2vw, 6rem);
    line-height: 1.1;
    transform: rotate(-7deg);
    transform-origin: left bottom;
    text-shadow:
      0.035em 0.045em 0 var(--outline),
      0 0 0.35em var(--glow-pink);
  }
  .block {
    font-size: clamp(2.5rem, 0.6rem + 4.3vw, 5.25rem);
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Chromatic glitch, on hover of the lockup only. */
  .lockup:hover .block {
    animation: glitch 700ms steps(1) infinite;
  }
  .lockup:hover .script {
    animation: glitch-script 700ms steps(1) infinite;
  }
  @keyframes glitch {
    0%,
    100% {
      text-shadow:
        -0.04em 0 0 var(--glow-cyan),
        0.04em 0 0 var(--glow-pink),
        0.06em 0.07em 0 var(--outline);
      transform: none;
    }
    30% {
      text-shadow:
        0.05em 0.01em 0 var(--glow-cyan),
        -0.05em -0.01em 0 var(--glow-pink),
        0.06em 0.07em 0 var(--outline);
      transform: translateX(-2px) skewX(-3deg);
      clip-path: inset(0 0 45% 0);
    }
    32% {
      clip-path: none;
    }
    60% {
      text-shadow:
        -0.02em 0 0 var(--glow-cyan),
        0.03em 0 0 var(--glow-pink),
        0.06em 0.07em 0 var(--outline);
      transform: translateX(2px);
    }
  }
  @keyframes glitch-script {
    0%,
    100% {
      text-shadow:
        -0.03em 0 0 var(--glow-cyan),
        0.035em 0.045em 0 var(--outline);
    }
    45% {
      text-shadow:
        0.04em 0 0 var(--glow-cyan),
        -0.02em 0 0 var(--c-changed),
        0.035em 0.045em 0 var(--outline);
      translate: 2px 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lockup:hover .block,
    .lockup:hover .script {
      animation: none;
      text-shadow:
        -0.03em 0 0 var(--glow-cyan),
        0.03em 0 0 var(--glow-pink),
        0.06em 0.07em 0 var(--outline);
    }
  }

  .role {
    margin-block-start: var(--s-6);
    max-inline-size: min(40rem, 50vw);
    color: var(--c-ink);
    font-size: clamp(1.1875rem, 1rem + 0.7vw, 1.5rem);
    font-weight: 600;
    line-height: 1.35;
    text-shadow: 0 1px 0 var(--outline);
  }

  .notes {
    display: grid;
    gap: var(--s-3);
    margin-block-start: var(--s-6);
  }
  .notes li {
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    align-items: baseline;
    column-gap: var(--s-4);
  }
  .notes li :global(.plate) {
    justify-self: start;
    transform: translateY(-0.1em);
  }
  .note-text {
    color: var(--c-ink2);
    font-size: 1rem;
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin-block-start: var(--s-7);
  }

  /* Tablet and phone: the sun sits over the text column's top, so the
     scene becomes a band and the text starts at the waterline. */
  @media (max-width: 63.99rem) {
    /* The scene is height-bound here, so its horizon sits at 62% of it
       (scene.horizonAt): the text starts just under the waterline. */
    .hero {
      --scene-h: calc(var(--header-h) + 48svh);
      justify-content: flex-start;
      padding-block-start: calc(var(--scene-h) * 0.62 + var(--s-3));
      min-block-size: auto;
    }
    .scene {
      --sun-at: 0.76;
      block-size: var(--scene-h);
      inset-block-end: auto;
    }
    .hero::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -2;
      background: var(--c-night);
    }
    /* The HUD column (left of the sun) gets its own calm ground. */
    .scrim {
      background:
        linear-gradient(to bottom, transparent 55%, color-mix(in srgb, var(--c-night) 88%, transparent) 80%, var(--c-night) 100%),
        linear-gradient(
          90deg,
          color-mix(in srgb, var(--c-night) 74%, transparent) 0,
          color-mix(in srgb, var(--c-night) 60%, transparent) 30%,
          transparent min(50%, var(--sun-left))
        );
    }
    /* The HUD moves to the left of the sun, a narrow column. */
    .hud {
      inset-inline: var(--pad) auto;
      align-items: flex-start;
      gap: var(--s-1);
      text-align: start;
    }
    .clock {
      min-block-size: 2.5rem;
    }
    .stats {
      align-items: flex-start;
      gap: var(--s-1);
    }
    .stats a {
      display: grid;
      grid-template-columns: auto auto;
      column-gap: var(--s-1);
      padding-inline: 0;
    }
    .stat-l {
      order: 0;
      grid-column: 1 / -1;
    }
    .notes,
    .role {
      max-inline-size: 40rem;
    }
    .copy {
      padding-block-start: var(--s-4);
      background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--c-night) 80%, transparent) 5rem);
    }
  }
  /* Phones: the name is the first thing read; the HUD follows the actions. */
  @media (max-width: 47.99rem) {
    .hud {
      position: relative;
      inset: auto;
      order: 2;
      margin-block-start: var(--s-6);
      padding-inline: var(--pad);
    }
  }
  @media (max-width: 29.99rem) {
    .stat-n {
      font-size: 1.125rem;
    }
    .notes li {
