---
/** Work: each product or library as a loading-screen card in a menu frame. */
import type { SiteView } from '../lib/view.ts';
import Entry from './Entry.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  view: SiteView;
}

const { view } = Astro.props;
const s = view.sections.work;
---

<section class="band work" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <SectionHead id="work" label={s.label} claim={s.claim} />
    <div class="cards">
      {view.work.map((entry) => <Entry entry={entry} field={view.field} />)}
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-8) var(--s-7);
  }
  @media (max-width: 63.99rem) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
