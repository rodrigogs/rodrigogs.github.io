---
/**
 * A featured project in a menu frame: its name, one sentence on what it
 * does, the short detail, at most two proof numbers, what it is made of,
 * and where to check it.
 */
import type { EntryView, SiteView } from '../lib/view.ts';
import EntryLinks from './EntryLinks.astro';
import Permalink from './Permalink.astro';
import Proofs from './Proofs.astro';

interface Props {
  entry: EntryView;
  field: SiteView['field'];
}

const { entry, field } = Astro.props;
---

<article class="frame card" id={entry.id} data-entry aria-labelledby={`${entry.id}-name`}>
  <div class="title-row">
    <h3 class="display card-title" id={`${entry.id}-name`}>{entry.name}</h3>
    <Permalink id={entry.id} name={entry.name} label={field.permalink} />
  </div>
  <p class="note">{entry.note}</p>
  <p class="detail">{entry.detail}</p>
  <div class="foot">
    <Proofs proofs={entry.proofs} />
    <p class="stack">
      {
        entry.stack.map((name, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <span class="tech">{name}</span>
          </>
        ))
      }
    </p>
    <EntryLinks links={entry.links} />
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .title-row {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-block-end: var(--s-1);
  }
  .card-title {
    font-size: clamp(1.625rem, 1.2rem + 1vw, 2.125rem);
    overflow-wrap: anywhere;
  }
  .note {
    color: var(--c-ink);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .detail {
    color: var(--c-ink2);
    font-size: 1rem;
    line-height: 1.6;
  }
  /* Proofs, stack and links sit on the card's floor, so cards of unequal copy still align. */
  .foot {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-block-start: auto;
    padding-block-start: var(--s-3);
  }
  .stack {
    color: var(--c-ink3);
    font-size: var(--t-small);
  }
  .tech {
    white-space: nowrap;
  }
</style>
