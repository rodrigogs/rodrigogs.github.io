---
/**
 * Career: a timeline along a boardwalk, newest first. Each role is a stop
 * on the planks with its dates as <time>; the current role is lit yellow.
 */
import type { SiteView } from '../lib/view.ts';
import Plate from './Plate.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  view: SiteView;
}

const { view } = Astro.props;
const s = view.sections.career;
---

<section class="band career" id="career" aria-labelledby="career-title">
  <div class="wrap">
    <SectionHead id="career" label={s.label} claim={s.claim} />
    <ol class="walk">
      {
        view.career.map((role) => (
          <li class="stop" data-current={role.current ? '' : undefined}>
            <p class="when">
              <time datetime={role.fromDatetime}>{role.from}</time>
              <span aria-hidden="true">–</span>
              {role.current ? (
                <Plate role="changed">{role.to}</Plate>
              ) : (
                <time datetime={role.toDatetime ?? undefined}>{role.to}</time>
              )}
            </p>
            <div class="what">
              <h3 class="org">
                {role.org}
                {role.via && <span class="via">via {role.via}</span>}
              </h3>
              <p class="title">{role.title}</p>
              {role.note && <p class="note">{role.note}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .walk {
    --rail: 1.25rem;
    position: relative;
    display: grid;
    gap: var(--s-6);
    padding-inline-start: calc(var(--rail) + var(--s-6));
  }
  /* The boardwalk: two rails and the planks between them. */
  .walk::before {
    content: '';
    position: absolute;
    inset-block: 0.5rem 0;
    inset-inline-start: 0;
    inline-size: var(--rail);
    border-inline: 2px solid var(--c-rule);
    background: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--scene-horizon) 40%, transparent) 0 2px,
      transparent 2px 12px
    );
  }
  .stop {
    position: relative;
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    column-gap: var(--s-6);
    align-items: baseline;
  }
  .stop::before {
    content: '';
    position: absolute;
    inset-inline-start: calc((var(--rail) + var(--s-6)) * -1 + var(--rail) / 2 - 0.5rem);
    inset-block-start: 0.35rem;
    inline-size: 1rem;
    block-size: 1rem;
    border: 3px solid var(--outline);
    border-radius: 50%;
    background: var(--c-brand);
  }
  .stop[data-current]::before {
    background: var(--c-changed);
    box-shadow: 0 0 1rem var(--c-changed);
  }
  .when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    color: var(--c-ink2);
    font-family: var(--hud);
    font-size: var(--t-small);
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .what {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }
  .org {
    font-size: 1.25rem;
    font-weight: 750;
    line-height: 1.3;
  }
  .stop[data-current] .org {
    color: var(--c-changed);
  }
  .via {
    margin-inline-start: var(--s-2);
    color: var(--c-ink3);
    font-size: var(--t-small);
    font-weight: 500;
  }
  .title {
    color: var(--c-ink2);
  }
  .note {
    color: var(--c-ink3);
    font-size: var(--t-small);
    max-inline-size: 60ch;
  }
  @media (max-width: 47.99rem) {
    .stop {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s-1);
    }
  }
</style>
