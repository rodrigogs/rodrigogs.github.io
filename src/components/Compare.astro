---
/**
 * Compare as a radio tuner: two dials, From and To ("◄ 2014 ►"), inside a
 * menu frame titled like a station display, diffing the stack between the
 * two years. The default range is server-rendered, so the diff reads the
 * same with JS off (the dials stay disabled then); src/scripts/compare.ts
 * enables them and takes over (URL state ?compare=BASE...HEAD, a polite
 * live region, the line motion). Past LIMIT lines the rest folds behind a
 * "+N more" disclosure.
 */
import { formatInt } from '../lib/derive.ts';
import { fill, type SiteView } from '../lib/view.ts';
import Icon from './Icon.astro';

interface Props {
  view: SiteView;
}

const { view } = Astro.props;
const c = view.compare;
const ui = view.ui;
const d = c.data;
const { added, removed, kept } = d.initial;
const lo = Math.min(d.base, d.head);
const hi = Math.max(d.base, d.head);
const repos = d.repoYears.filter((y) => y >= lo && y <= hi).length;
const num = (n: number) => formatInt(n, view.locale);
const word = (n: number, many: string, one: string) => (n === 1 ? one : many);

/** Lines shown before the fold; a fold never hides a single line. */
const LIMIT = 10;
// Removals first, as in a unified diff, so the fold never hides every − line.
const lines = [...removed.map((name) => ({ kind: 'rem' as const, name })), ...added.map((name) => ({ kind: 'add' as const, name }))];
const folds = lines.length > LIMIT + 1;
const tail = folds ? lines.slice(LIMIT) : [];
const tailAdded = tail.filter((l) => l.kind === 'add').length;
const tailRemoved = tail.length - tailAdded;

/** GitHub-style five-block diffstat: blocks split by the added:removed ratio. */
function blocks(a: number, r: number): ('add' | 'rem' | 'none')[] {
  const total = a + r;
  if (total === 0) return ['none', 'none', 'none', 'none', 'none'];
  let adds = Math.round((5 * a) / total);
  if (a > 0 && adds === 0) adds = 1;
  if (r > 0 && adds === 5) adds = 4;
  return Array.from({ length: 5 }, (_, i) => (i < adds ? 'add' : 'rem'));
}

const dials = [
  { name: 'base', label: c.base, value: d.base },
  { name: 'head', label: c.head, value: d.head },
] as const;

const payload = JSON.stringify({
  years: d.years,
  stackByYear: d.stackByYear,
  repoYears: d.repoYears,
  base: d.base,
  head: d.head,
}).replace(/</g, '\\u003c');
---

<form
  class="frame tuner"
  data-compare
  data-lang={view.lang}
  data-added={c.added}
  data-added-one={c.addedOne}
  data-removed={c.removed}
  data-removed-one={c.removedOne}
  data-kept={c.kept}
  data-kept-one={c.keptOne}
  data-work={c.work}
  data-work-one={c.workOne}
  data-limit={LIMIT}
>
  <div class="tuner-head">
    <h3 class="tuner-title" id="compare-title">{c.label}</h3>
    <p class="frame-label" aria-hidden="true">{ui.station}</p>
  </div>
  <p class="hint" id="compare-hint">{c.hint}</p>

  <div class="dials" role="group" aria-labelledby="compare-title" aria-describedby="compare-hint">
    {
      dials.map((dial) => (
        <div class="dial">
          <label class="dial-label" for={`compare-${dial.name}`}>
            {dial.label}
          </label>
          <div class="dial-row">
            <button type="button" class="step" data-step={dial.name} data-dir="-1" aria-label={`${ui.earlier}, ${dial.label}`} disabled>
              <Icon name="prev" size={18} />
            </button>
            <select class="year" id={`compare-${dial.name}`} name={dial.name} disabled>
              {d.years.map((y) => (
                <option value={y} selected={y === dial.value}>
                  {y}
                </option>
              ))}
            </select>
            <button type="button" class="step" data-step={dial.name} data-dir="1" aria-label={`${ui.later}, ${dial.label}`} disabled>
              <Icon name="next" size={18} />
            </button>
          </div>
        </div>
      ))
    }
  </div>

  <div class="readout">
    <div class="stat">
      <span class="count"
        ><span class="n add" data-out="added">+{num(added.length)}</span>{' '}
        <span data-out="added-word">{word(added.length, c.added, c.addedOne)}</span></span
      >
      <span class="count"
        ><span class="n rem" data-out="removed">−{num(removed.length)}</span>{' '}
        <span data-out="removed-word">{word(removed.length, c.removed, c.removedOne)}</span></span
      >
      <span class="blocks" aria-hidden="true" data-out="blocks">
        {blocks(added.length, removed.length).map((k) => <i data-kind={k} />)}
      </span>
    </div>

    <p class="meta">
      <span
        ><span class="n2" data-out="kept">{num(kept.length)}</span>{' '}
        <span data-out="kept-word">{word(kept.length, c.kept, c.keptOne)}</span></span
      >
      <span data-out="work">{fill(word(repos, c.work, c.workOne), { repos: num(repos) })}</span>
    </p>

    <ul class="lines" id="compare-lines" data-out="lines" data-collapsed={folds ? '' : undefined} aria-label={c.label}>
      {
        lines.map(({ kind, name }, i) => (
          <li class="line" data-kind={kind} data-key={`${kind}:${name}`} data-tail={i >= LIMIT ? '' : undefined}>
            <Icon name={kind === 'add' ? 'plus' : 'minus'} size={12} />
            <span>{name}</span>
          </li>
        ))
      }
    </ul>
    <button class="more" type="button" aria-controls="compare-lines" aria-expanded="false" data-out="more" hidden={!folds}>
      <Icon name="unfold" size={12} class="g-unfold" />
      <Icon name="fold" size={12} class="g-fold" />
      <span data-out="more-removed" class="rem" hidden={tailRemoved === 0}>−{num(tailRemoved)}</span>
      <span data-out="more-added" class="add" hidden={tailAdded === 0}>+{num(tailAdded)}</span>
      <span class="w-more">{c.more}</span>
      <span class="w-less">{c.less}</span>
    </button>
    <p class="sr-only" aria-live="polite" data-out="announce"></p>
  </div>

  <script type="application/json" data-compare-data set:html={payload} />
</form>

<template data-line-template>
  <li class="line">
    <Icon name="plus" size={12} class="g-add" />
    <Icon name="minus" size={12} class="g-rem" />
    <span></span>
  </li>
</template>

<script>
  import '../scripts/compare.ts';
</script>

<style>
  .tuner {
    --tilt: 0.6deg;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .tuner-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .tuner-title {
    font-family: var(--display);
    font-size: 1.75rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--c-ink);
    -webkit-text-stroke: 0.14em var(--outline);
    paint-order: stroke fill;
  }
  .hint {
    color: var(--c-ink2);
    font-size: var(--t-small);
  }

  /* The dials: an LCD strip per year, arrows either side. */
  .dials {
    display: grid;
    gap: var(--s-3);
  }
  .dial {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: center;
    gap: var(--s-3);
  }
  .dial-label {
    color: var(--c-brand);
    font-family: var(--hud);
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .dial-row {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
    align-items: stretch;
    border: 3px solid var(--outline);
    border-radius: 10px;
    background: var(--c-on-added);
    overflow: hidden;
  }
  .step {
    display: grid;
    place-items: center;
    min-block-size: 3rem;
    border: 0;
    background: color-mix(in srgb, var(--c-added) 16%, var(--c-on-added));
    color: var(--c-added);
    cursor: pointer;
  }
  .step:hover:not(:disabled) {
    background: var(--c-select);
    color: var(--c-on-select);
  }
  .step:focus-visible,
  .year:focus-visible {
    outline-offset: -3px;
    background: var(--c-select);
    color: var(--c-on-select);
  }
  .step:disabled {
    color: color-mix(in srgb, var(--c-added) 35%, var(--c-on-added));
    cursor: default;
  }
  .year {
    appearance: none;
    min-inline-size: 0;
    padding: 0 var(--s-1);
    border: 0;
    background: transparent;
    color: var(--c-added);
    font-family: var(--hud);
    font-size: 1.625rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-align: center;
    text-align-last: center;
    text-shadow: 0 0 0.4em var(--glow-cyan);
    cursor: pointer;
  }
  .year:disabled {
    opacity: 1;
    cursor: default;
  }
  .year:hover:not(:disabled) {
    background: color-mix(in srgb, var(--c-added) 12%, transparent);
  }
  .year option {
    background: var(--c-panel);
    color: var(--c-ink);
  }

  .readout {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding-block-start: var(--s-2);
  }
  .stat {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-5);
    font-size: var(--t-small);
    color: var(--c-ink2);
  }
  .n {
    font-variant-numeric: tabular-nums;
    font-family: var(--hud);
    font-size: 1.375rem;
    font-weight: 800;
  }
  .add {
    color: var(--c-added);
  }
  .rem {
    color: var(--c-deprecated);
  }
  .blocks {
    display: inline-flex;
    gap: 3px;
  }
  .blocks i {
    inline-size: 0.625rem;
    block-size: 0.625rem;
    border-radius: 2px;
    background: var(--c-rule);
  }
  .blocks i[data-kind='add'] {
    background: var(--c-added);
  }
  .blocks i[data-kind='rem'] {
    background: var(--c-deprecated);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-5);
    color: var(--c-ink3);
    font-size: var(--t-small);
  }
  .n2 {
    color: var(--c-ink2);
    font-family: var(--hud);
    font-weight: 700;
  }
  .lines {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    gap: 2px var(--s-3);
    font-size: var(--t-small);
  }
  .line {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-block-size: 1.75rem;
    padding-inline: var(--s-2);
    border-radius: 4px;
  }
  .line[data-kind='add'] {
    background: var(--c-added-tint);
    color: var(--c-ink);
  }
  .line[data-kind='add'] :global(.icon) {
    color: var(--c-added);
  }
  .line[data-kind='rem'] {
    background: var(--c-deprecated-tint);
    color: var(--c-ink);
  }
  .line[data-kind='rem'] :global(.icon) {
    color: var(--c-deprecated);
  }
  .line :global(.g-add),
  .line :global(.g-rem) {
    display: none;
  }
  .line[data-kind='add'] :global(.g-add),
  .line[data-kind='rem'] :global(.g-rem) {
    display: block;
  }
  :global(.leaving) {
    text-decoration: line-through;
  }
  .lines[data-collapsed] .line[data-tail] {
    display: none;
  }
  .more {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--s-2);
    min-block-size: 2.5rem;
    padding-inline: var(--s-3);
    border: 2px solid var(--c-rule);
    border-radius: 10px;
    background: transparent;
    color: var(--c-ink);
    font-size: var(--t-small);
    font-weight: 700;
    cursor: pointer;
  }
  .more[hidden] {
    display: none;
  }
  .more:hover {
    background: var(--c-select);
    color: var(--c-on-select);
    border-color: var(--c-select);
  }
  .more:hover .add,
  .more:hover .rem {
    color: inherit;
  }
  .more .add,
  .more .rem {
    font-family: var(--hud);
  }
  .more[aria-expanded='true'] :global(.g-unfold),
  .more[aria-expanded='false'] :global(.g-fold),
  .more[aria-expanded='true'] .w-more,
  .more[aria-expanded='true'] .add,
  .more[aria-expanded='true'] .rem,
  .more[aria-expanded='false'] .w-less {
    display: none;
  }
</style>
