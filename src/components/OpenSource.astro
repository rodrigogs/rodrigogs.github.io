---
/**
 * Open source: work that landed in other people's projects, as one compact
 * list in a menu frame. Each row: the repository, the count that links to
 * its proof, and one line on what landed.
 */
import type { SiteView } from '../lib/view.ts';
import SectionHead from './SectionHead.astro';

interface Props {
  view: SiteView;
}

const { view } = Astro.props;
const s = view.sections.openSource;
---

<section class="band open-source" id="open-source" aria-labelledby="open-source-title">
  <div class="wrap">
    <SectionHead id="open-source" label={s.label} claim={s.claim} />
    <ul class="frame rows">
      {
        view.upstream.map((row) => {
          const [owner, name] = row.repo.split('/');
          return (
            <li class="row">
              <h3 class="name">
                <a href={row.url}>
                  <span class="owner">{owner}/</span><wbr />{name}
                </a>
              </h3>
              <p class="count">
                <a href={row.proofUrl}>
                  <span class="n">{row.countValue}</span> {row.countLabel}
                </a>
              </p>
              <p class="note">{row.note}</p>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 11rem) minmax(0, 1fr);
    align-items: baseline;
    gap: var(--s-1) var(--s-6);
    padding-block: var(--s-4);
  }
  .row + .row {
    border-block-start: 1px solid var(--c-rule);
  }
  .name {
    font-size: 1.0625rem;
    font-weight: 700;
    overflow-wrap: break-word;
  }
  .owner {
    color: var(--c-ink3);
    font-weight: 500;
  }
  .name a:hover .owner {
    color: inherit;
  }
  .count {
    font-size: var(--t-small);
    white-space: nowrap;
  }
  .count a {
    text-decoration: none;
  }
  .n {
    font-variant-numeric: tabular-nums;
    color: var(--c-merged-text);
    font-family: var(--hud);
    font-size: 1.125rem;
    font-weight: 800;
  }
  .count a:hover .n {
    color: inherit;
  }
  .note {
    color: var(--c-ink2);
    font-size: 1rem;
    max-inline-size: 70ch;
  }
  @media (max-width: 63.99rem) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .note {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 29.99rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
