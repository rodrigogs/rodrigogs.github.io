---
/**
 * Packages as a HUD table: each row's neon bar is its share of the most
 * downloaded package (linear, last 30 days), data, not decoration. The top
 * rows are open; the long tail sits behind a native disclosure.
 */
import { fill, type PackageView, type SiteView } from '../lib/view.ts';
import SectionHead from './SectionHead.astro';

interface Props {
  view: SiteView;
}

const { view } = Astro.props;
const s = view.sections.packages;
const f = view.field;
const OPEN = 12;
const rows = [...view.packages].sort((a, b) => b.monthlyRaw - a.monthlyRaw);
const max = Math.max(1, ...rows.map((p) => p.monthlyRaw));
const head = rows.slice(0, OPEN);
const tail = rows.slice(OPEN);
const share = (p: PackageView) => (p.monthlyRaw / max).toFixed(4);
const registryName = { npm: 'npm', crates: 'crates.io' } as const;
---

<section class="band packages" id="packages" aria-labelledby="packages-title">
  <div class="wrap">
    <SectionHead id="packages" label={s.label} claim={s.claim} />
    <div class="frame listing">
      {
        [head, tail].map((group, gi) => {
          const table = (
            <table class:list={['pkgs', gi > 0 && 'pkgs-tail']}>
              <thead class:list={[gi > 0 && 'sr-only']}>
                <tr>
                  <th scope="col">{f.name}</th>
                  <th scope="col" class="c-reg">{f.registry}</th>
                  <th scope="col" class="c-ver">{f.version}</th>
                  <th scope="col" colspan="2" class="num">
                    {f.downloadsMonth}
                  </th>
                </tr>
              </thead>
              <tbody>
                {group.map((p) => (
                  <tr>
                    <th scope="row" class="pkg">
                      <a href={p.url}>{p.name}</a>
                    </th>
                    <td class="c-reg">{registryName[p.registry]}</td>
                    <td class="c-ver hud-t">{p.version ?? ''}</td>
                    <td class="bar-cell" aria-hidden="true">
                      <span class="bar" style={`--v:${share(p)}`} />
                    </td>
                    <td class="num hud-t">{p.monthly}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          );
          if (gi === 0) return table;
          if (group.length === 0) return null;
          return (
            <details class="more">
              <summary>{fill(f.allPackages, { count: view.totals.packages })}</summary>
              {table}
            </details>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .pkgs {
    inline-size: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: var(--t-small);
  }
  th,
  td {
    padding: var(--s-2) var(--s-3);
    text-align: start;
    vertical-align: middle;
  }
  thead th {
    color: var(--c-brand);
    font-family: var(--hud);
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-block-end: 1px solid var(--c-rule);
  }
  thead th:nth-child(1) {
    inline-size: 34%;
  }
  .c-reg {
    inline-size: 12%;
    color: var(--c-ink2);
  }
  .c-ver {
    inline-size: 14%;
  }
  thead .num {
    inline-size: 40%;
    /* The column label may wrap on phones; only the figures stay on one line. */
    white-space: normal;
  }
  tbody tr + tr > * {
    border-block-start: 1px solid color-mix(in srgb, var(--c-rule) 55%, transparent);
  }
  .pkg {
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .hud-t {
    font-variant-numeric: tabular-nums;
    font-family: var(--hud);
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--c-ink2);
  }
  .num {
    text-align: end;
    color: var(--c-added);
    font-size: 1rem;
    white-space: nowrap;
  }
  .bar-cell {
    inline-size: 26%;
  }
  .bar {
    display: block;
    block-size: 0.5rem;
    inline-size: calc(max(var(--v), 0.004) * 100%);
    border-radius: 999px;
    background: linear-gradient(90deg, var(--c-merged), var(--c-added));
    box-shadow: 0 0 0.6rem var(--glow-cyan);
  }
  .more {
    margin-block-start: var(--s-4);
  }
  summary {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: var(--s-4);
    border: 2px solid var(--c-rule);
    border-radius: 10px;
    font-weight: 700;
    cursor: pointer;
  }
  summary:hover {
    background: var(--c-select);
    color: var(--c-on-select);
    border-color: var(--c-select);
  }
  .pkgs-tail {
    margin-block-start: var(--s-4);
  }
  @media (max-width: 47.99rem) {
    .c-reg,
    .c-ver {
      display: none;
    }
    thead th:nth-child(1) {
      inline-size: 50%;
    }
    thead .num {
      inline-size: 50%;
    }
    .bar-cell {
      inline-size: 22%;
      padding-inline: var(--s-1);
    }
  }
</style>
