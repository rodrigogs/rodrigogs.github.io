---
/**
 * The whole page for one locale. Loads the committed snapshot and builds
 * the view model once at build time; every component only renders it.
 */
import type { Locale } from '../content/site.ts';
import type { Snapshot } from '../data/schema.ts';
import snapshotJson from '../data/snapshot.json';
import Base from '../layouts/Base.astro';
import { buildView } from '../lib/view.ts';
import About from './About.astro';
import Career from './Career.astro';
import Cheat from './Cheat.astro';
import Contact from './Contact.astro';
import Hero from './Hero.astro';
import OpenSource from './OpenSource.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import Toast from './Toast.astro';
import Work from './Work.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const view = buildView(snapshotJson as unknown as Snapshot, locale, {
  now: new Date(),
  sha: process.env.GIT_SHA ?? '',
});
---

<Base view={view}>
  <div id="top"></div>
  <SiteHeader view={view} />
  <main id="main" tabindex="-1">
    <Hero view={view} />
    <About view={view} />
    <Work view={view} />
    <OpenSource view={view} />
    <Career view={view} />
    <Contact view={view} />
  </main>
  <SiteFooter view={view} />
  <Toast title={view.ui.toast} subtitle={view.ui.toastSub} />
  <Cheat on={view.ui.cheatOn} off={view.ui.cheatOff} />
</Base>
