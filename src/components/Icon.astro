---
/**
 * The site's only icon set: drawn on a 16px grid, one 1.5px square-capped
 * stroke, so every glyph matches the square plates.
 */
export type IconName = 'plus' | 'minus' | 'mail' | 'copy' | 'check' | 'hash' | 'external' | 'up' | 'unfold' | 'fold';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: cls } = Astro.props;

const paths: Record<IconName, string> = {
  plus: 'M8 3v10M3 8h10',
  minus: 'M3 8h10',
  mail: 'M2.75 3.75h10.5v8.5H2.75zM3 4.25l5 4.25 5-4.25',
  copy: 'M5.75 5.75h7.5v7.5h-7.5zM10.25 3.25v-0.5h-7.5v7.5h0.5',
  check: 'M3 8.5l3 3 7-7',
  hash: 'M6.25 2.75l-1 10.5M10.75 2.75l-1 10.5M2.75 6h10.5M2.25 10.25h10.5',
  external: 'M5 11l6-6M6.25 4.75h4.75v4.75',
  up: 'M8 13V3.5M4 7.25l4-4 4 4',
  unfold: 'M4.75 5.75L8 2.5l3.25 3.25M4.75 10.25L8 13.5l3.25-3.25',
  fold: 'M4.75 2.75L8 6l3.25-3.25M4.75 13.25L8 10l3.25 3.25',
};
---

<svg
  class:list={['icon', `icon-${name}`, cls]}
  viewBox="0 0 16 16"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"
  ></path>
</svg>
