---
/**
 * The site's only icon set, drawn on a 16px grid: one 1.5px square-capped
 * stroke for line glyphs, and two solid glyphs (the HUD star, the pause-menu
 * bars) that read as filled marks at HUD size.
 */
export type IconName =
  | 'mail'
  | 'copy'
  | 'check'
  | 'hash'
  | 'external'
  | 'up'
  | 'download'
  | 'pulse'
  | 'star'
  | 'pause';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: cls } = Astro.props;

const lines: Partial<Record<IconName, string>> = {
  mail: 'M2.75 3.75h10.5v8.5H2.75zM3 4.25l5 4.25 5-4.25',
  copy: 'M5.75 5.75h7.5v7.5h-7.5zM10.25 3.25v-0.5h-7.5v7.5h0.5',
  check: 'M3 8.5l3 3 7-7',
  hash: 'M6.25 2.75l-1 10.5M10.75 2.75l-1 10.5M2.75 6h10.5M2.25 10.25h10.5',
  external: 'M5 11l6-6M6.25 4.75h4.75v4.75',
  up: 'M8 13V3.5M4 7.25l4-4 4 4',
  download: 'M8 2.5v8M4.5 7l3.5 3.5L11.5 7M2.75 13.25h10.5',
  pulse: 'M1.75 8.5h2.75l1.75-4.5 3 8 1.75-3.5h3.25',
};

const solids: Partial<Record<IconName, string>> = {
  star: 'M8 1.25l2.05 4.3 4.7.6-3.45 3.25.87 4.65L8 11.8l-4.17 2.25.87-4.65L1.25 6.15l4.7-.6z',
  pause: 'M3.5 2.5h3v11h-3zM9.5 2.5h3v11h-3z',
};

const solid = solids[name];
---

<svg
  class:list={['icon', `icon-${name}`, cls]}
  viewBox="0 0 16 16"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  {
    solid ? (
      <path d={solid} fill="currentColor" />
    ) : (
      <path
        d={lines[name]}
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="square"
        stroke-linejoin="miter"
      />
    )
  }
</svg>
