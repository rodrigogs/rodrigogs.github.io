---
/**
 * Stack, printed as a manifest: the "Ships with" line first, then the
 * grouped tooling. The AI capabilities live in the AI engineering section.
 */
import type { SiteView } from '../lib/view.ts';
import SectionHead from './SectionHead.astro';

interface Props {
  view: SiteView;
}

const { view } = Astro.props;
const s = view.sections.toolchain;
const t = view.toolchain;
---

<section class="band field-sheet toolchain" id="toolchain" aria-labelledby="toolchain-title">
  <div class="wrap grid">
    <div class="lead">
      <SectionHead id="toolchain" label={s.label} claim={s.claim} />
    </div>

    <div class="manifest">
      <div class="ships">
        <h3 class="ships-label">{t.ships.label}</h3>
        <ul class="ships-list">
          {t.ships.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <dl class="groups">
        {
          t.groups.map((g) => (
            <div class="group">
              <dt>{g.label}</dt>
              <dd>
                <ul>
                  {g.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

  </div>
</section>

<style>
  .toolchain {
    padding-block: var(--s-9);
  }
  .grid {
    row-gap: var(--s-8);
  }
  .lead {
    grid-column: 1 / span 4;
  }
  .manifest {
    grid-column: 5 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }
  .ships {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding-block-end: var(--s-6);
    border-block-end: 1px solid var(--c-ink);
  }
  .ships-label {
    font-size: var(--t-small);
    font-weight: 700;
    line-height: 1.25rem;
    color: var(--c-ink3);
  }
  .ships-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
    font-size: clamp(var(--t-lead), 1rem + 0.9vw, var(--t-h3));
    font-stretch: 112%;
    font-weight: 800;
    line-height: 2rem;
    letter-spacing: -0.012em;
  }
  .ships-list li:not(:last-child)::after {
    content: '/';
    margin-inline-start: var(--s-4);
    color: var(--c-rule);
    font-weight: 400;
  }
  .groups {
    display: flex;
    flex-direction: column;
  }
  .group {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    column-gap: var(--s-5);
    padding-block: var(--s-3);
    border-block-end: 1px solid var(--c-rule);
  }
  dt {
    color: var(--c-ink3);
    font-size: var(--t-small);
    font-weight: 600;
    line-height: 1.5rem;
  }
  dd ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-2);
  }
  dd li:not(:last-child)::after {
    content: ',';
  }

  @media (max-width: 63.99rem) {
    .lead,
    .manifest {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 47.99rem) {
    .group {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
