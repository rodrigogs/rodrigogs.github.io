---
/**
 * Proof numbers: the figure in the HUD face, the label in prose. Every
 * figure with a source links to it.
 */
import type { ProofView } from '../lib/view.ts';

interface Props {
  proofs: ProofView[];
  class?: string;
}

const { proofs, class: cls } = Astro.props;
---

{
  proofs.length > 0 && (
    <ul class:list={['proofs', cls]}>
      {proofs.map((p) => (
        <li>
          {p.href ? (
            <a href={p.href}>
              <span class="n">{p.value}</span> <span class="l">{p.label}</span>
            </a>
          ) : (
            <span>
              <span class="n">{p.value}</span> <span class="l">{p.label}</span>
            </span>
          )}
        </li>
      ))}
    </ul>
  )
}

<style>
  .proofs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
  }
  .proofs a {
    text-decoration: none;
    padding-inline: 0.125rem;
  }
  .n {
    color: var(--c-changed);
    font-family: var(--hud);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .l {
    color: var(--c-ink2);
    font-size: var(--t-small);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--c-brand) 70%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.24em;
  }
  span > .l {
    text-decoration: none;
  }
  .proofs a:hover .n,
  .proofs a:hover .l {
    color: var(--c-on-select);
    text-decoration-color: transparent;
  }
</style>
