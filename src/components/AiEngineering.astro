---
/**
 * AI engineering, on a full-bleed amber field: the agent projects first
 * (two-up, six columns each), then the capabilities they prove (name, one
 * sentence, a link where there is public proof). Quiet density, large type.
 */
import type { SiteView } from '../lib/view.ts';
import EntryLinks from './EntryLinks.astro';
import Permalink from './Permalink.astro';
import Proofs from './Proofs.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  view: SiteView;
}

const { view } = Astro.props;
const s = view.sections.ai;
const caps = view.aiWorkflow;
---

<section class="band field-changed ai" id="ai" aria-labelledby="ai-title">
  <div class="wrap grid">
    <div class="lead">
      <SectionHead id="ai" label={s.label} claim={s.claim} />
    </div>
    <ol class="items">
      {
        view.ai.map((item) => (
          <li class="item" id={item.id} data-entry>
            <div class="title-row">
              <h3 class="name">{item.name}</h3>
              <Permalink id={item.id} name={item.name} label={view.field.permalink} />
            </div>
            <p class="note">{item.note}</p>
            <Proofs proofs={item.proofs} />
            <EntryLinks links={item.links} />
          </li>
        ))
      }
    </ol>

    <div class="skills-wrap">
      <h3 class="skills-label">{caps.label}</h3>
      <ul class="skills">
        {
          caps.items.map((skill) => (
            <li class="skill">
              <h4 class="skill-name">{skill.name}</h4>
              <p class="skill-text">{skill.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .ai {
    padding-block: var(--s-10);
  }
  .grid {
    row-gap: var(--s-8);
  }
  .lead {
    grid-column: 1 / -1;
  }
  .lead :global(.claim) {
    max-inline-size: 24ch;
    font-size: clamp(var(--t-h3), 1rem + 1.6vw, 2.25rem);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .items {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding-block: var(--s-5) var(--s-7);
    border-block-start: 1px solid var(--line);
  }
  .title-row {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  .name {
    font-stretch: 125%;
    font-weight: 800;
    font-size: var(--t-h3);
    line-height: 2rem;
    letter-spacing: -0.015em;
  }
  .note {
    max-inline-size: 60ch;
    font-size: var(--t-lead);
    line-height: 1.75rem;
  }
  .item :global(.proofs .n) {
    font-weight: 700;
  }

  .skills-wrap {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .skills-label {
    font-size: var(--t-small);
    font-weight: 700;
    line-height: 1.25rem;
    color: var(--fg-2);
  }
  .skills {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--gutter);
  }
  .skill {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding-block: var(--s-4) var(--s-5);
    border-block-start: 1px solid var(--line);
  }
  .skill-name {
    font-size: var(--t-body);
    font-weight: 700;
    line-height: 1.5rem;
  }
  .skill-name a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
  }
  .skill-text {
    color: var(--fg-2);
    font-size: var(--t-small);
    line-height: 1.25rem;
  }
  @media (max-width: 63.99rem) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 47.99rem) {
    .items,
    .skills {
      grid-template-columns: minmax(0, 1fr);
    }
    .item:last-child {
      padding-block-end: 0;
    }
  }
</style>
